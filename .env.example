# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Server-side OpenAI document extraction (never prefix the API key with NEXT_PUBLIC_)
OPENAI_API_KEY="sk-proj-your-server-side-key"
OPENAI_INVOICE_MODEL="gpt-5-mini"

# Reserved for optional self-hosted infrastructure
DATABASE_URL="postgresql://finpilot:finpilot@localhost:5432/finpilot"
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_BUCKET="finpilot-documents"
